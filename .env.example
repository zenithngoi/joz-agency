# Copy to .env.local for local dev. In Vercel, set these as Project env vars
# (Settings -> Environment Variables). All VITE_* vars are public -- they ship
# in the browser bundle -- so only ever put publishable/anon-level keys here.

VITE_API_URL=http://localhost:3001

# Supabase Auth (P0-1 fix) -- from Supabase dashboard: Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
